<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:View/Layout:etc/page_configuration.xsd">
    <update handle="loki_admin_components_form"/>

    <head>
        <title>Products (Loki) Quick Edit</title>
    </head>

    <body>
        <referenceContainer name="content">
            <block
                name="loki_admin_products.form"
                template="Loki_AdminComponents::form.phtml">
                <arguments>
                    <argument name="provider" xsi:type="string">Magento\Catalog\Api\ProductRepositoryInterface</argument>
                    <argument name="acl_resource" xsi:type="string">YireoTraining_ExampleLokiAdminProducts::form</argument>
                    <argument name="save_acl_resource" xsi:type="string">Magento_Catalog::products</argument>
                    <argument name="delete_acl_resource" xsi:type="string">Magento_Catalog::products</argument>
                    <argument name="fields" xsi:type="array">
                        <item name="status" xsi:type="array">
                            <item name="label" xsi:type="string">Enabled</item>
                            <item name="field_type" xsi:type="string">select</item>
                            <item name="options" xsi:type="string">Magento\Catalog\Model\Product\Attribute\Source\Status</item>
                            <item name="required" xsi:type="boolean">true</item>
                            <item name="sort_order" xsi:type="number">10</item>
                        </item>
                        <item name="name" xsi:type="array">
                            <item name="label" xsi:type="string">Product Name</item>
                            <item name="field_type" xsi:type="string">input</item>
                            <item name="required" xsi:type="boolean">true</item>
                            <item name="sort_order" xsi:type="number">20</item>
                        </item>
                        <item name="sku" xsi:type="array">
                            <item name="label" xsi:type="string">SKU</item>
                            <item name="field_type" xsi:type="string">input</item>
                            <item name="required" xsi:type="boolean">true</item>
                            <item name="sort_order" xsi:type="number">30</item>
                        </item>
                        <item name="price" xsi:type="array">
                            <item name="label" xsi:type="string">Price</item>
                            <item name="field_type" xsi:type="string">input</item>
                            <item name="required" xsi:type="boolean">true</item>
                            <item name="sort_order" xsi:type="number">40</item>
                        </item>
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
